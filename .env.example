# Copy to .env, or enter these in Portainer's stack "Environment variables".
# .env is git-ignored, so the output token stays out of the repository.

# Required: the manager output's playlist link (Connect your apps).
M3U_URL=http://192.168.1.15:8080/o/YOUR_TOKEN/playlist.m3u
# Required: where recordings go on the NAS.
RECORDINGS_PATH=/volume1/media/Recordings

# Optional (defaults shown).
TZ=America/Chicago
PUID=1026
PGID=100
CONFIG_PATH=/volume1/docker/simple-iptv-recorder
