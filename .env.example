# Copy to .env (or enter these in Portainer's stack "Environment variables").
# .env is git-ignored: the output token stays out of the repository.

# The manager output's links (Outputs → your Recorder output → Connect your apps).
M3U_URL=http://192.168.1.15:8080/o/YOUR_TOKEN/playlist.m3u
EPG_URL=http://192.168.1.15:8080/o/YOUR_TOKEN/epg.xml

# Where recordings go on the NAS (TV/ and Movies/ are created inside it).
RECORDINGS_PATH=/volume1/media/Recordings
# Settings database and schedules (back this folder up).
CONFIG_PATH=/volume1/docker/simple-iptv-recorder

TZ=America/Chicago
# Your Synology user and group: run `id` over SSH. Usually 1026 and 100 (users).
PUID=1026
PGID=100

# The manager's limit: Settings → Light streams → "At most at once" (and the
# provider's connection count, whichever is lower).
MAX_STREAMS=4

WEB_PORT=8089
REFRESH_HOURS=6
PRE_PADDING_MIN=2
POST_PADDING_MIN=5
RETENTION_DAYS=0
NTFY_URL=
PUSHBULLET_TOKEN=
# Record the manager's light (converted) stream by default when a channel has one.
PREFER_LIGHT=false
